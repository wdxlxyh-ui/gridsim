      "children": [
        {
          "id": "builtin-29fee7d7",
          "name": "login - 登录获取 token",
          "type": "request",
          "method": "POST",
          "url": "{{base_url}}/api/v1/auth/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
          "pre_script": "// Pre-Script 示例：发送前生成动态值\nvars.request_id = $uuid();\nvars.request_time = $formatTime('yyyy-MM-dd HH:mm:ss');\nconsole.log('准备登录, request_id=', vars.request_id);",
          "test_script": "// Post-Script 示例：登录成功后自动将 token 写入环境变量 {{token}}\nvar data = pm.response.json();\nif (data.token) {\n  pm.environment.set('token', data.token);\n  console.log('token 已保存:', data.token.substring(0, 20) + '...');\n}\npm.expect(pm.response.code).to.equal(200);"
        }
      ]
    },
